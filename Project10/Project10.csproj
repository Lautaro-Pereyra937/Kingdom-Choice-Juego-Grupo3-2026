<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Ignora copias anidadas del proyecto (carpeta Project10 dentro del proyecto) para que no se compilen dos veces -->
  <ItemGroup>
    <Compile Remove="Project10\**" />
    <EmbeddedResource Remove="Project10\**" />
    <None Remove="Project10\**" />
  </ItemGroup>
  <!-- Si existen las copias viejas de la raíz Y las de Datos\, se usa solo la de la raíz -->
  <ItemGroup>
    <Compile Remove="Datos\AppDbContext.cs" Condition="Exists('AppDbContext.cs')" />
    <Compile Remove="Datos\BaseDatos.cs" Condition="Exists('BaseDatos.cs')" />
    <Compile Remove="Datos\Entidades.cs" Condition="Exists('Entidades.cs')" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Audio\**\*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>